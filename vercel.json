{
  "version": 2,
  "builds": [
    {
      "src": "api/server.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "src/lib/**",
          "src/types.ts"
        ]
      }
    },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/dist/assets/$1" },
    { "src": "/api/(.*)", "dest": "/api/server.ts" },
    { "src": "/((?!api/|assets/).*)", "dest": "/dist/index.html" }
  ]
}
