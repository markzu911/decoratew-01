{
  "version": 2,
  "builds": [
    { "src": "api/server.mjs", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/dist/assets/$1" },
    { "src": "/api/(.*)", "dest": "/api/server.mjs" },
    { "src": "/((?!api/|assets/).*)", "dest": "/dist/index.html" }
  ]
}
